{
  "expo": {
    "name": "personal-website",
    "slug": "personal-website",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "personalwebsite",
    "userInterfaceStyle": "automatic",
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#e7e7e7"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.mattlarsen0.personalwebsite"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mattlarsen0.personalwebsite"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#e7e7e7",
          "dark": {
            "backgroundColor": "#e7e7e7"
          }
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Merriweather-Light.ttf",
            "./assets/fonts/Oswald-Regular.ttf",
            "./assets/fonts/SpaceMono-Regular.ttf"
          ],
          "android": {
            "fonts": [
              {
                "fontFamily": "Merriweather-Light",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/Merriweather-Light.ttf",
                    "weight": 400
                  }
                ]
              },
              {
                "fontFamily": "Oswald-Regular",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/Oswald-Regular.ttf",
                    "weight": 400
                  }
                ]
              },
              {
                "fontFamily": "SpaceMono-Regular",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/SpaceMono-Regular.ttf",
                    "weight": 400
                  }
                ]
              }
            ]
          },
          "ios": {
            "fonts": [
              "./assets/fonts/Merriweather-Light.ttf",
              "./assets/fonts/Oswald-Regular.ttf",
              "./assets/fonts/SpaceMono-Regular.ttf"
            ]
          }
        }
      ],
      "expo-image",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d00748b7-5234-40a4-8ac4-f54990df5887"
      }
    }
  }
}
